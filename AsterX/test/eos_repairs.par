# Startup unit tests only. The C2P suite includes a synthetic tabulated EOS
# with negative physical eps, so this input needs no external EOS table.
# No reference output has been generated; run after reviewing and rebuilding.
ActiveThorns = "
  CarpetX CarpetXRegrid IOUtil ODESolvers ADMBaseX HydroBaseX TmunuBaseX
  AsterMasks AsterUtils EOSX ReconX Con2PrimFactory AsterSeeds AsterX
"

Cactus::presync_mode = "mixed-error"
Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

EOSX::unit_test = yes
Con2PrimFactory::unit_test = yes
ReconX::unit_test = yes
AsterSeeds::unit_test = yes
AsterX::unit_test = yes
EOSX::eos_call_diagnostics_every = 1
AsterX::repair_every = 1

EOSX::initial_data_eos = "Polytropic"
EOSX::evolution_eos = "IdealGas"
EOSX::poly_gamma = 2.0
EOSX::gl_gamma = 2.0
EOSX::rho_max = 1.0e8
EOSX::eps_max = 1.0e8

ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"
ADMBaseX::initial_dtlapse = "none"
ADMBaseX::initial_dtshift = "none"

CarpetX::xmin = -0.5
CarpetX::ymin = -0.5
CarpetX::zmin = -0.5
CarpetX::xmax = 0.5
CarpetX::ymax = 0.5
CarpetX::zmax = 0.5
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_num_levels = 1
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25
CarpetX::boundary_x = "linear extrapolation"
CarpetX::boundary_y = "linear extrapolation"
CarpetX::boundary_z = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

AsterSeeds::test_type = "1DTest"
AsterSeeds::test_case = "Balsara1"
AsterSeeds::shock_dir = "x"
AsterX::update_tmunu = no
AsterX::flux_type = "HLLE"
ReconX::reconstruction_method = "ppm"

Con2PrimFactory::c2p_prime = "Noble"
Con2PrimFactory::c2p_second = "Palenzuela"
Con2PrimFactory::rho_abs_min = 1.0e-10
Con2PrimFactory::B_lim = 1.0e8
Con2PrimFactory::vw_lim = 10.0
ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::parfile_write = no
CarpetX::out_metadata = no
