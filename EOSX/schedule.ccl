# Schedule definitions for thorn EOSX

SCHEDULE EOSX_Setup_EOSID AT CCTK_WRAGH
{
  LANG: C
  OPTIONS: GLOBAL
} "set up initial data EOS"

SCHEDULE EOSX_Setup_EOS AT CCTK_WRAGH AFTER EOSX_Setup_EOSID
{
  LANG: C
  OPTIONS: GLOBAL
} "set up evolution EOS"

if (unit_test) {
  SCHEDULE EOSX_Test AT CCTK_WRAGH AFTER EOSX_Setup_EOS
  {
    LANG: C
    OPTIONS: GLOBAL
  } "Test EOS interpolation, closure and device round trips"
}

if (eos_call_diagnostics_every > 0) {
  SCHEDULE EOSX_ReportCalls AT CCTK_POSTSTEP
  {
    LANG: C
    OPTIONS: GLOBAL
  } "Report cumulative EOS API and inversion counts"
}
